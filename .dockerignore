# Whitelist: deny everything, then allow only what the image build needs.
# A blacklist eventually misses a new secret file — that is how .env.production and
# service-account keys reached the builder layer. Do not convert this back to a blacklist.
*

# Manifests
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Build configuration
!tsconfig.base.json
!tsconfig.json

# Workspace sources
!packages
!apps
!examples

# Never ship build output or dependencies from the host
packages/*/dist
packages/*/node_modules
apps/*/dist
apps/*/node_modules
examples/*/node_modules
**/*.tsbuildinfo
