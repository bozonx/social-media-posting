{
  "name": "social-posting-workspace",
  "version": "0.3.0",
  "description": "Web-standard library for publishing to social networks, plus an HTTP shell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bozonx/social-posting-server dev",
    "dev:worker": "pnpm --filter @bozonx/social-posting-server dev:worker",
    "deploy:worker": "pnpm --filter @bozonx/social-posting-server deploy:worker",
    "start": "pnpm --filter @bozonx/social-posting-server start",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "clean": "pnpm -r run clean && rm -rf coverage *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:packages": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project core --project platforms --project server --project example-embedded --project example-custom-platform --project conformance",
    "test:unit": "vitest run --project core --project platforms --project server --project example-embedded --project example-custom-platform --project conformance",
    "test:e2e": "vitest run --project e2e",
    "test:contract": "vitest run packages/platform-*/test/contract.spec.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:deps": "node scripts/check-zero-deps.mjs",
    "check:publish": "pnpm -r --filter \"./packages/*\" exec publint && pnpm -r --filter \"./packages/*\" exec attw --pack . --profile esm-only",
    "publish:packages": "pnpm --filter @bozonx/social-posting --filter @bozonx/social-posting-telegram --filter @bozonx/social-posting-discord --filter @bozonx/social-posting-youtube --filter @bozonx/social-posting-vimeo --filter @bozonx/social-posting-dailymotion --filter @bozonx/social-posting-threads --filter @bozonx/social-posting-instagram --filter @bozonx/social-posting-facebook --filter @bozonx/social-posting-platform-catalog --filter @bozonx/social-posting-conformance publish --access public --no-git-checks",
    "publish:packages:dry": "pnpm --filter @bozonx/social-posting --filter @bozonx/social-posting-telegram --filter @bozonx/social-posting-discord --filter @bozonx/social-posting-youtube --filter @bozonx/social-posting-vimeo --filter @bozonx/social-posting-dailymotion --filter @bozonx/social-posting-threads --filter @bozonx/social-posting-instagram --filter @bozonx/social-posting-facebook --filter @bozonx/social-posting-platform-catalog --filter @bozonx/social-posting-conformance publish --access public --dry-run --no-git-checks",
    "publish:all": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "validate": "pnpm check && pnpm --filter @bozonx/social-posting build && pnpm test:unit",
    "validate:all": "pnpm check && pnpm check:deps && pnpm build && pnpm typecheck:packages && pnpm test:unit && pnpm test:e2e && pnpm test:workerd && pnpm check:publish",
    "docker:build": "docker compose -f apps/server/docker/docker-compose.yml build",
    "docker:up": "docker compose -f apps/server/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/server/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f apps/server/docker/docker-compose.yml logs -f",
    "rebuild": "pnpm clean && pnpm build",
    "platform": "node scripts/scaffold-platform.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "author": "Ivan K",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozonx/social-media-posting.git"
  },
  "bugs": {
    "url": "https://github.com/bozonx/social-media-posting/issues"
  },
  "homepage": "https://github.com/bozonx/social-media-posting#readme"
}
