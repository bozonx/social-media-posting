{
  "name": "@bozonx/social-posting-server",
  "version": "2.0.0",
  "private": true,
  "description": "HTTP shell around @bozonx/social-posting for non-Node consumers",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "NODE_ENV=development node --enable-source-maps --watch dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@bozonx/social-posting": "workspace:*",
    "@bozonx/social-posting-telegram": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.0",
    "js-yaml": "^4.1.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/js-yaml": "^4.0.9",
    "pino-pretty": "^13.1.3"
  },
  "author": "Ivan K",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
