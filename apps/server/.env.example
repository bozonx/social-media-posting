# Runtime settings of the HTTP shell.
#
# Everything here is read from the environment, never from a file, so the same
# image runs on a VM, in Docker and on Cloudflare Workers. Accounts and platform
# settings live in config.yaml (or CONFIG_JSON) instead.

# — listening —
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# Mount every route under a prefix, e.g. /api/v1.
BASE_PATH=

# — authentication —
# Comma-separated bearer tokens accepted on every route. Empty disables auth,
# which is only reasonable behind a trusted proxy.
AUTH_BEARER_TOKENS=
# Allow credentials inline in the request body instead of a configured account.
ALLOW_INLINE_AUTH=false

# — payloads —
# Body limit for the JSON endpoints, in bytes. It does NOT apply to
# POST /post/stream: that route exists precisely for media too large to buffer,
# and its body is handed to the adapter as a stream.
MAX_REQUEST_BODY_BYTES=1048576

# — diagnostics —
LOG_LEVEL=warn
# Include the platform's raw payload in responses. Off outside debugging: raw
# payloads routinely carry identifiers you would rather not log.
INCLUDE_RAW_RESPONSES=false
SERVICE_NAME=social-posting-server
SERVICE_VERSION=dev

# — lifecycle —
# Seconds to keep serving in-flight requests after a shutdown signal.
SHUTDOWN_DRAIN_SECONDS=5

# — configuration —
# Accounts as JSON, for runtimes with no filesystem (Workers). When set it
# replaces config.yaml entirely.
# CONFIG_JSON={"accounts":{"main":{"platform":"telegram","auth":{"apiKey":"..."},"target":"@channel"}}}
