# Application environment: development | production | test.
NODE_ENV=development
# HTTP bind address.
LISTEN_HOST=localhost
# HTTP bind port.
LISTEN_PORT=8080
# Optional proxy path prefix.
# BASE_PATH=
# Pino log level.
LOG_LEVEL=debug
# Application timezone.
TZ=UTC
# Optional service-name override.
# SERVICE_NAME=
# Seconds to expose shutting_down before closing.
SHUTDOWN_DRAIN_SECONDS=5
# Comma-separated Bearer tokens; unset makes the API public.
# AUTH_BEARER_TOKENS=
# YAML platform configuration path.
CONFIG_PATH=./config.yaml
