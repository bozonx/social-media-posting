# Application environment: development | production | test.
NODE_ENV=development
# HTTP bind address. Docker overrides this to 0.0.0.0.
LISTEN_HOST=localhost
# HTTP bind port.
LISTEN_PORT=8080
# Optional proxy path prefix.
# BASE_PATH=
# Log level: debug | info | warn | error | silent.
LOG_LEVEL=debug
# Application timezone.
TZ=UTC
# Optional service-name override.
# SERVICE_NAME=
# Seconds to expose shutting_down before closing.
SHUTDOWN_DRAIN_SECONDS=5
# Comma-separated Bearer tokens; unset makes the API public.
# AUTH_BEARER_TOKENS=
# Allow callers to provide social-network credentials in request bodies.
ALLOW_INLINE_AUTH=false
# Include raw platform payloads in successful HTTP responses.
INCLUDE_RAW_RESPONSES=false
# Maximum JSON request body size (1 KiB to 10 MiB).
MAX_REQUEST_BODY_BYTES=1048576
# YAML platform configuration path (Node deployment only). Docker overrides this to /app/config.yaml.
CONFIG_PATH=./apps/server/config.yaml
# The whole configuration as JSON. Required on Cloudflare Workers, which has no filesystem.
# CONFIG_JSON=
