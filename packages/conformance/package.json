  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozonx/social-media-posting.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/bozonx/social-media-posting/issues"
  },
  "homepage": "https://github.com/bozonx/social-media-posting/tree/main/packages/conformance#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "author": "Ivan K",
