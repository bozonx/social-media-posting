{
  "name": "@bozonx/social-posting-conformance",
  "version": "0.6.0",
  "description": "Contract test suite every @bozonx/social-posting platform must pass",
  "keywords": [
    "social-media",
    "posting",
    "testing",
    "contract-tests"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@bozonx/social-posting": "workspace:^",
    "vitest": ">=3"
