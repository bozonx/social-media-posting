{
  "name": "@bozonx/social-posting-telegram",
  "version": "0.5.0",
  "description": "Telegram platform for @bozonx/social-posting",
  "keywords": [
    "social-media",
    "posting",
    "telegram"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project platforms",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@bozonx/social-posting": "workspace:^"
  },
  "devDependencies": {
    "@bozonx/social-posting": "workspace:*",
    "@bozonx/social-posting-conformance": "workspace:*"
  },
  "author": "Ivan K",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozonx/social-media-posting.git",
    "directory": "packages/platform-telegram"
  },
  "bugs": {
    "url": "https://github.com/bozonx/social-media-posting/issues"
  },
  "homepage": "https://github.com/bozonx/social-media-posting/tree/main/packages/platform-telegram#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
