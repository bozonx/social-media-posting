{
  "name": "@bozonx/social-posting",
  "version": "2.0.0",
  "description": "Framework-free core for publishing posts to social networks",
  "keywords": [
    "social-media",
    "posting",
    "publishing",
    "automation",
    "library"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {},
  "author": "Ivan K",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
