{
  "name": "@bozonx/social-posting",
  "version": "0.7.0",
  "description": "Framework-free core for publishing posts to social networks",
  "keywords": [
    "social-media",
    "posting",
    "publishing",
    "automation",
    "library"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "workerd": "./dist/platform.js",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project core",
    "test:workerd": "pnpm -w exec vitest run --config vitest.workerd.config.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "author": "Ivan K",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozonx/social-media-posting.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bozonx/social-media-posting/issues"
  },
  "homepage": "https://github.com/bozonx/social-media-posting/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
